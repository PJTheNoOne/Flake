# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*
flake.lock

# Ignore automatically generated direnv output
.direnv

# =============================================
# PI (pi-coding-agent) - ignore temp files only
# Keep versioned configs in git!
# =============================================

# Agent sessions (logs from PI sessions)
common/pi/agent/sessions/*/*/*.jsonl

# Models cache - generated by PI, not tracked
common/pi/agent/models-store.json

# Temporary plugin caches and build outputs
.codex/.tmp/plugins/*

# Logs and temporary agent data
common/pi/logs/*

# Backup files (auto-generated when loading config)
.pi/backups/*
